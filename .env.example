# Optional local configuration; real values belong only in ignored .env.local.
# Never prefix server secrets with NEXT_PUBLIC_. No credentials belong here.
DB_PATH=./data/jefpass.sqlite
# Recommended explicit browser-facing origin behind proxies or on a LAN.
# Set this to the actual HTTPS origin for deployment. Forwarded headers are not trusted.
APP_ORIGIN=http://localhost:3100

# Optional: exactly 32 bytes encoded as 64 hex characters or base64.
# Empty generates a durable key beside DB_PATH (default: data/key).
APP_ENCRYPTION_KEY=
# Issuer key is generated beside DB_PATH (default: data/issuer-private.pem).
# There are no supported receipt issuer environment variables.

# Supported: regtest (default), testnet, signet; wallet getInfo must match.
# Mainnet is always disabled, regardless of flags.
LIGHTNING_NETWORK=regtest

# Required for wallet connection; empty fails closed. Exact comma-separated URLs.
# Entries must match parsed target URL.href, including a trailing slash.
# Example only, NOT a reachable service: wss://relay.wallet-provider.example/
# Use reviewed trusted WSS relays from the specific wallet configuration.
# No separate private-address filter exists beyond WSS and the operator allowlist.
NWC_ALLOWED_RELAYS=

# Optional comma-separated PUBLIC relay URLs for worker commitment publication.
# Browser-visible: never include credentials or private wallet endpoints.
NEXT_PUBLIC_NOSTR_RELAYS=

# Optional AI: empty means no provider call. No paid calls made for this demo.
# Never send wallet secrets, customer links, or private identifying details.
OPENAI_API_KEY=
AI_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini

# Wallet credentials are entered privately in authenticated worker settings,
# then encrypted at rest; no NWC_URI environment variable is supported.
