# Optional local configuration. Keep real values in an ignored .env.local.
# Never use NEXT_PUBLIC_ for server secrets.
DB_PATH=./data/jefpass.sqlite

# Local development example. Production must set the exact browser-facing HTTPS origin.
APP_ORIGIN=http://localhost:3100

# Optional: exactly 32 bytes encoded as 64 hexadecimal characters or base64.
# If empty, a persistent key is generated locally or stored in the D1 app_secrets table.
APP_ENCRYPTION_KEY=

# Supported: regtest (default), testnet, signet. Mainnet is always disabled.
LIGHTNING_NETWORK=regtest

# Required to connect an NWC wallet. Comma-separated exact WSS relay URLs.
# Values must match URL.href after normalization, including trailing slash.
# Empty fails closed. Use only relays explicitly trusted by the operator and wallet.
NWC_ALLOWED_RELAYS=

# Optional PUBLIC browser-visible relay list for worker receipt commitment publication only.
# Never put private wallet relay credentials or NWC secrets here.
NEXT_PUBLIC_NOSTR_RELAYS=

# Optional AI "Help write scope" assistant. A key alone does nothing;
# AI_ENABLED must explicitly be true. The local draft fallback needs no key.
#
# Works with any OpenAI-compatible provider via AI_BASE_URL.
#   OpenAI (default):  AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4.1-mini
#   Fireworks:         AI_BASE_URL=https://api.fireworks.ai/inference/v1
#                      AI_MODEL=accounts/fireworks/models/gpt-oss-120b
#   (pick any model from your Fireworks catalog; names change over time)
#
# AI_API_KEY is the bearer token (put your Fireworks key here locally; in
# production set it as a Worker SECRET, never a plain var or in git).
AI_ENABLED=false
AI_BASE_URL=https://api.fireworks.ai/inference/v1
AI_MODEL=accounts/fireworks/models/gpt-oss-120b
AI_API_KEY=
# Legacy aliases still honored: OPENAI_API_KEY, OPENAI_MODEL
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Cloudflare Workers set JEFPASS_CLOUDFLARE=true and inject the DB D1 binding via wrangler.jsonc.
# Local development leaves JEFPASS_CLOUDFLARE unset/false and uses DB_PATH.
JEFPASS_CLOUDFLARE=false
