{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jefpass",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jefpass"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jefpass-db",
      "database_id": "162b1629-d063-4d11-ac7a-ffdc8e3b743d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "JEFPASS_CLOUDFLARE": "true",
    "LIGHTNING_NETWORK": "regtest",
    "AI_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}
